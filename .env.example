# Copy to .env and adjust. Every setting is documented in docs/CONFIGURATION.md.

# development or production
CSE_PROFILE=development

# where the database, uploads and logs live
CSE_DATA_DIR=data

# bind address and port
CSE_HOST=127.0.0.1
CSE_PORT=8080

# require this key on every API call (leave empty to run without auth)
CSE_API_KEY=

# folders that may be added as sources; required in production
CSE_ALLOWED_ROOTS=

# embedding models to keep dense indexes for (comma separated); empty = keyword search only
CSE_EMBEDDING_MODELS=BAAI/bge-small-en-v1.5

# rerank by default with a cross-encoder (clients can toggle per search)
CSE_RERANK=false

# read scanned pages and images with OCR (needs: pip install "contextsearch[ocr]")
CSE_OCR=false
